{
  "dryRun": false,
  "fetcher": {
    "throttleSeconds": [30, 60, 120, 240, 480, 600, 900, 1800]
  },
  "indices": {
    "paths": [
      "crawl-data/CC-MAIN-2025-08/cc-index.paths.gz"
    ]
  },
  "docs": {
    "path": "docs/video"
  },
  "maxFilesExtracted": 1000,
  "maxFilesTruncated": -1,
  "maxRecords": -1,
  "numThreads": 2,
  "recordSelector": {
    "must": {
      "status": [
        {
          "match": "200"
        }
      ]
    },
    "should": {
      "mime_detected": [
        {
          "match": "video/mp4"
        },
        {
          "match": "video/webm"
        },
        {
          "match": "video/quicktime"
        }
      ]
    }
  },
  "targetPathPattern": "xx/xx/xxx"
}
