{
  "_comment": "Cyrillic-region HTML pages whose servers declared a non-UTF-8 charset. Targets legacy windows-1251 / KOI8-R / IBM866 documents — the OWLGVDY-class fixture source for charset-detection regression testing.",
  "dryRun": true,
  "fetcher": {
    "throttleSeconds": [30, 60, 120, 240, 480, 600, 900, 1800]
  },
  "indices": {
    "paths": [
      "crawl-data/CC-MAIN-2025-08/cc-index.paths.gz"
    ]
  },
  "docs": {
    "path": "docs/charset-cyrillic-non-utf8"
  },
  "maxFilesExtracted": 1000,
  "maxFilesTruncated": -1,
  "maxRecords": -1,
  "numThreads": 2,
  "recordSelector": {
    "must": {
      "status": [{"match": "200"}],
      "mime_detected": [
        {"match": "text/html"},
        {"match": "application/xhtml+xml"}
      ]
    },
    "must_not": {
      "charset": [
        {"match": "utf-8", "case_sensitive": false},
        {"match": "utf8", "case_sensitive": false}
      ]
    },
    "should": {
      "tld": [
        {"match": "ru"}, {"match": "ua"}, {"match": "by"},
        {"match": "kz"}, {"match": "bg"}, {"match": "rs"},
        {"match": "mk"}, {"match": "uz"}
      ]
    }
  },
  "targetPathPattern": "xx/xx/xxx"
}
