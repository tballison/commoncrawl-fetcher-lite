{
  "_comment": "HTML pages with NO declared charset (neither HTTP Content-Type charset parameter nor <meta charset>). These are pure detection territory — Tika's NB classifier is the only signal. The hardest cases for charset detection.",
  "dryRun": true,
  "fetcher": {
    "throttleSeconds": [30, 60, 120, 240, 480, 600, 900, 1800]
  },
  "indices": {
    "paths": [
      "crawl-data/CC-MAIN-2025-08/cc-index.paths.gz"
    ]
  },
  "docs": {
    "path": "docs/charset-declaration-absent"
  },
  "maxFilesExtracted": 1000,
  "numThreads": 2,
  "recordSelector": {
    "must": {
      "status": [{"match": "200"}],
      "mime_detected": [
        {"match": "text/html"},
        {"match": "application/xhtml+xml"}
      ],
      "charset": [{"match": ""}]
    }
  },
  "targetPathPattern": "xx/xx/xxx"
}
